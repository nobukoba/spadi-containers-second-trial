# DAQ dependencies
# Keep NestDAQ-facing dependencies aligned with the actual v1.0.0 source API.
# The v1.0.0 README still says redis-plus-plus 1.2.1 (recipes branch), but the
# released source includes <sw/redis++/patterns/redlock.h>. That path entered
# redis-plus-plus master in Oct 2022 and first appears in an official release
# at 1.3.6. FairMQ is allowed at 1.4.26 or later; v1.4.55 remains pinned here.
LIBZMQ_VERSION=v4.3.5
FMT_VERSION=10.2.1
FAIRMQ_VERSION=v1.4.55
HIREDIS_VERSION=v1.0.0
REDIS_PLUS_PLUS_VERSION=1.3.6
# AlmaLinux 9 supplies Valkey as the Redis-compatible runtime service.
# RedisTimeSeries is built separately for NestDAQ TS.* metrics support.
REDISTIMESERIES_VERSION=v1.10.24

# ROOT / ARTEMIS
# ARTEMIS develops on the moving develop branch; pin the tested develop commit.
ARTEMIS_REF=c74e24adf90a83227fa3e5c38dc255ddc4aeb785
ROOT_VERSION=v6-32-06
YAML_CPP_VERSION=0.8.0
